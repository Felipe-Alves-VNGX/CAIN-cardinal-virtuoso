<div class="cv-kim cv-kim-drop">

  <div class="cv-kim-drop-head">
    <span class="cv-kim-drop-ico">📦</span>
    <div class="cv-kim-drop-id">
      <span class="cv-kim-drop-title">DEAD DROP</span>
      <span class="cv-kim-drop-sub">HQ Contraband Manifest</span>
    </div>
    <span class="cv-kim-drop-stock {{#unless hqStock}}cv-kim-drop-empty{{/unless}}">HQ {{hqStock}}/{{hqCap}}</span>
  </div>

  {{#if canWrite}}
  <div class="cv-kim-drop-form">
    <label>{{localize 'cain-cardinal-virtuoso.drop.recipient'}}</label>
    <select name="dropVirtue">
      {{#each contacts}}
      <option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}} — {{status}}{{#if bonded}} ({{used}}/{{../cap}}){{else}} {{localize 'cain-cardinal-virtuoso.drop.noBond'}}{{/if}}</option>
      {{/each}}
    </select>

    <label>{{localize 'cain-cardinal-virtuoso.drop.package'}}</label>
    <select name="dropKind">
      <option value="favorite">{{localize 'cain-cardinal-virtuoso.drop.favorite'}} (+3)</option>
      <option value="like">{{localize 'cain-cardinal-virtuoso.drop.like'}} (+3)</option>
      <option value="neutral">{{localize 'cain-cardinal-virtuoso.drop.neutral'}} (+1)</option>
      <option value="dislike">{{localize 'cain-cardinal-virtuoso.drop.dislike'}} (&minus;3)</option>
      <option value="hatemail">{{localize 'cain-cardinal-virtuoso.drop.hatemail'}} (&minus;3)</option>
    </select>

    <button type="button" class="cv-btn cv-btn-on" data-action="drop">{{localize 'cain-cardinal-virtuoso.drop.send'}} &#9656;</button>
  </div>
  <div class="cv-kim-drop-hint">{{localize 'cain-cardinal-virtuoso.drop.hint'}}</div>
  {{else}}
  <div class="cv-kim-drop-hint">{{localize 'cain-cardinal-virtuoso.drop.noClearance'}}</div>
  {{/if}}

  <div class="cv-kim-drop-log">
    <div class="cv-kim-group">{{localize 'cain-cardinal-virtuoso.drop.recent'}}</div>
    <ul class="cv-kim-notes">
      {{#each drops}}<li>{{this}}</li>{{else}}<li class="cv-kim-empty">{{localize 'cain-cardinal-virtuoso.drop.noDrops'}}</li>{{/each}}
    </ul>
  </div>

</div>
