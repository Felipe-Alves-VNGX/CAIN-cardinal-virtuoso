<div class="cv-kim cv-kim-hq">

  <div class="cv-kim-drop-head">
    <span class="cv-kim-drop-ico">⚙</span>
    <div class="cv-kim-drop-id">
      <span class="cv-kim-drop-title">HQ CONSOLE</span>
      <span class="cv-kim-drop-sub">SEER//TEMERITY operative config</span>
    </div>
    <span class="cv-kim-drop-stock">M{{mission}}</span>
  </div>

  {{#if canWrite}}
  <div class="cv-kim-hq-form">
    <div class="cv-kim-hq-row">
      <label>{{localize 'cain-cardinal-virtuoso.hq.codename'}}</label>
      <input type="text" name="codename" value="{{codename}}" maxlength="24" placeholder="—" />
    </div>

    <div class="cv-kim-hq-row cv-kim-hq-check">
      <label><input type="checkbox" name="x2mod" {{#if x2mod}}checked{{/if}} /> {{localize 'cain-cardinal-virtuoso.hq.x2mod'}}</label>
    </div>
    <div class="cv-kim-hq-row cv-kim-hq-check">
      <label><input type="checkbox" name="gateUser" {{#if gateUser}}checked{{/if}} /> {{localize 'cain-cardinal-virtuoso.hq.gateUser'}}</label>
    </div>

    <div class="cv-kim-hq-grid">
      <div class="cv-kim-hq-cell">
        <label>{{localize 'cain-cardinal-virtuoso.hq.covert'}}</label>
        <input type="number" name="covert" value="{{covert}}" min="0" max="9" />
      </div>
      <div class="cv-kim-hq-cell">
        <label>{{localize 'cain-cardinal-virtuoso.hq.cat'}}</label>
        <input type="number" name="cat" value="{{cat}}" min="0" max="9" />
      </div>
      <div class="cv-kim-hq-cell">
        <label>{{localize 'cain-cardinal-virtuoso.hq.hqStock'}}</label>
        <input type="number" name="hqStock" value="{{hqStock}}" min="0" max="{{hqCap}}" />
      </div>
    </div>

    <div class="cv-kim-hq-readout">
      <span>{{localize 'cain-cardinal-virtuoso.hq.nextHaul'}} +{{nextHaul}}</span>
      <span>{{localize 'cain-cardinal-virtuoso.hq.bonds'}} {{bondsUsed}}/{{bondsAllowed}}</span>
    </div>

    <div class="cv-kim-hq-actions">
      <button type="button" class="cv-btn cv-btn-on" data-action="saveHQ">{{localize 'cain-cardinal-virtuoso.hq.save'}}</button>
      <button type="button" class="cv-btn cv-btn-bad" data-action="reset">{{localize 'cain-cardinal-virtuoso.hq.wipe'}}</button>
    </div>
  </div>
  <div class="cv-kim-drop-hint">{{localize 'cain-cardinal-virtuoso.hq.hint'}} {{hqCap}}.</div>
  {{else}}
  <div class="cv-kim-drop-hint">{{localize 'cain-cardinal-virtuoso.hq.noClearance'}}</div>
  {{/if}}

</div>
