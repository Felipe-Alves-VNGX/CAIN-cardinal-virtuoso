<div class="cv-kim cv-kim-profile {{#if broken}}cv-kim-broken{{/if}}">

  <div class="cv-kim-p-head">
    <div class="cv-kim-p-av">
      <span class="cv-kim-p-glyph">{{glyph}}</span>
      {{#if portrait}}<img class="cv-portrait cv-kim-p-img" src="{{portrait}}" alt="{{name}}" />{{/if}}
    </div>
    <div class="cv-kim-p-id">
      <span class="cv-kim-p-name">{{name}}</span>
      <span class="cv-kim-p-epi">{{epithet}}</span>
      <span class="cv-kim-p-status cv-kim-st-{{statusClass}}" title="{{rankFlavor}}">{{status}}</span>
    </div>
  </div>

  <div class="cv-kim-p-aff">
    <div class="cv-kim-p-aff-head">
      <span class="cv-aff-num {{#if affCrit}}crit{{/if}}">{{affinity}}</span>
      <div class="cv-kim-p-aff-meta">
        <span class="cv-kim-aff-lbl">{{localize 'cain-cardinal-virtuoso.prof.affinity'}}</span>
        <span class="cv-kim-aff-rank">{{localize 'cain-cardinal-virtuoso.prof.bond'}} {{rank}}</span>
        {{#if reqNext}}<span class="cv-kim-aff-next">{{localize 'cain-cardinal-virtuoso.prof.next'}}: {{reqNext}}</span>{{/if}}
      </div>
    </div>
    <div class="cv-trk-bar cv-kim-p-aff-bar">
      <div class="cv-trk-fill" style="width: {{affPct}}%;"></div>
    </div>
  </div>

  {{#if bondText}}<div class="cv-kim-p-bond">{{bondText}}</div>{{/if}}

  <div class="cv-kim-p-actions">
    {{#if canWrite}}
    <button type="button" class="cv-btn {{#if bonded}}cv-btn-on{{/if}}" data-action="toggleBond" data-virtue="{{key}}">
      {{#if bonded}}{{localize 'cain-cardinal-virtuoso.prof.removeContact'}}{{else}}{{localize 'cain-cardinal-virtuoso.prof.addContact'}}{{/if}}
    </button>
    {{/if}}
  </div>

  <details class="cv-kim-p-sec" open>
    <summary>{{localize 'cain-cardinal-virtuoso.prof.intel'}}</summary>
    <div class="cv-kim-intel">
      <p><b>{{localize 'cain-cardinal-virtuoso.prof.likes'}}</b> {{#each likes}}<span class="cv-tag cv-tag-good">{{this}}</span>{{/each}}</p>
      <p><b>{{localize 'cain-cardinal-virtuoso.prof.dislikes'}}</b> {{#each dislikes}}<span class="cv-tag cv-tag-bad">{{this}}</span>{{/each}}</p>
      {{#if food.length}}<p><b>{{localize 'cain-cardinal-virtuoso.prof.food'}}</b> {{#each food}}<span class="cv-tag">{{this}}</span>{{/each}}</p>{{/if}}
      {{#if blasphemy}}<p><b>{{localize 'cain-cardinal-virtuoso.prof.blasphemy'}}</b> {{blasphemy}}</p>{{/if}}
    </div>
  </details>

  {{#if canWrite}}
  <details class="cv-kim-p-sec">
    <summary>{{localize 'cain-cardinal-virtuoso.prof.contraband'}}</summary>
    <div class="cv-kim-contra">
      <button type="button" class="cv-btn cv-btn-on" data-action="openDrop" data-virtue="{{key}}">{{localize 'cain-cardinal-virtuoso.prof.openDrop'}}</button>
    </div>
  </details>

  {{#if isGM}}
  {{#if quirks.length}}
  <details class="cv-kim-p-sec">
    <summary>{{localize 'cain-cardinal-virtuoso.prof.quirks'}}</summary>
    <div class="cv-kim-quirks">
      {{#each quirks}}
      <button type="button" class="cv-btn cv-quirk {{#if good}}cv-btn-good{{else}}cv-btn-bad{{/if}}"
              data-action="quirk" data-q="{{index}}" data-virtue="{{../key}}">
        <span class="cv-quirk-d">{{deltaStr}}</span> {{label}}
        {{#if perMission}}<small>({{used}}/{{perMission}})</small>{{/if}}
      </button>
      {{/each}}
    </div>
  </details>
  {{/if}}
  {{/if}}

  {{#if isGM}}
  <div class="cv-kim-p-adj">
    <label>{{localize 'cain-cardinal-virtuoso.prof.adminAdj'}}</label>
    <input type="number" name="adj-{{key}}" value="0" step="1" />
    <button type="button" class="cv-btn" data-action="adjust" data-virtue="{{key}}">{{localize 'cain-cardinal-virtuoso.prof.apply'}}</button>
  </div>
  {{/if}}
  {{/if}}

  <details class="cv-kim-p-sec" open>
    <summary>{{localize 'cain-cardinal-virtuoso.prof.notes'}}</summary>
    <ul class="cv-kim-notes">
      {{#each notes}}<li>{{this}}</li>{{else}}<li class="cv-kim-empty">{{localize 'cain-cardinal-virtuoso.prof.noHistory'}}</li>{{/each}}
    </ul>
  </details>

</div>
