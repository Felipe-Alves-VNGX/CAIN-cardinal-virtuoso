<div class="cv-root">
  <div class="cv-titlebar">
    <span class="cv-ico">✝</span>
    <span class="cv-tt">CARDINAL_VIRTUOSO.EXE — SEER//TEMERITY {{#if codename}}[{{codename}}]{{/if}}</span>
    <span class="cv-tbtns">
      <span class="cv-tbtn">_</span><span class="cv-tbtn">□</span><span class="cv-tbtn">✕</span>
    </span>
  </div>
  <div class="cv-menubar">
    <span><u>F</u>ile</span><span><u>V</u>iew</span><span><u>M</u>ission</span><span><u>H</u>elp</span>
  </div>

  <div class="cv-body">
  {{#if isGM}}
  <div class="cv-gmbar">
    <label class="cv-lbl">ADMIN OVERWATCH — OPERATIVE:</label>
    <select class="cv-select" data-action="pickUser">
      {{#each allUsers}}
      <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}{{#unless active}} (offline){{/unless}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}

  <section class="cv-meta">
    <div class="cv-field">
      <label class="cv-lbl">CODENAME</label>
      <input class="cv-input" name="codename" value="{{codename}}" placeholder="—" />
    </div>
    <div class="cv-field cv-field-sm">
      <label class="cv-lbl">MISSION</label>
      <div class="cv-stat">{{mission}}</div>
    </div>
    <div class="cv-field cv-field-sm">
      <label class="cv-lbl" title="Covert score — feeds the post-mission contraband haul">COVERT</label>
      <input class="cv-input cv-input-num" name="covert" type="number" min="0" max="9" value="{{covert}}" />
    </div>
    <div class="cv-field cv-field-sm">
      <label class="cv-lbl" title="CAT — half of it (rounded down) feeds the contraband haul">CAT</label>
      <input class="cv-input cv-input-num" name="cat" type="number" min="0" max="9" value="{{cat}}" />
    </div>
    <div class="cv-field cv-field-sm">
      <label class="cv-lbl">HQ STOCK</label>
      <input class="cv-input cv-input-num" name="hqStock" type="number" min="0" max="6" value="{{hqStock}}" />
    </div>
    <div class="cv-field cv-field-sm">
      <label class="cv-lbl" title="Gate users collect +1 contraband per mission">GATE</label>
      <label class="cv-toggle"><input type="checkbox" name="gateUser" {{#if gateUser}}checked{{/if}} /><span></span></label>
    </div>
    <div class="cv-field cv-field-sm">
      <label class="cv-lbl">X2 MOD</label>
      <label class="cv-toggle"><input type="checkbox" name="x2mod" {{#if x2mod}}checked{{/if}} /><span></span></label>
    </div>
    <button class="cv-btn cv-btn-ghost" data-action="saveMeta">SAVE</button>
  </section>

  <div class="cv-limits">
    BONDS {{bondsUsed}}/{{bondsAllowed}} &nbsp;·&nbsp; CONV {{convCap}}/MISSION &nbsp;·&nbsp;
    CONTRABAND {{contraCap}}/MISSION (STOCK {{hqStock}}/6, NEXT HAUL +{{nextHaul}}) &nbsp;·&nbsp;
    HEART BREAK AT −5
  </div>

  <section class="cv-grid">
    {{#each virtues}}
    <article class="cv-card {{#if bonded}}is-bonded{{/if}} {{#if broken}}is-broken{{/if}}">
      <div class="cv-card-head">
        <span class="cv-glyph">{{glyph}}</span>
        <div class="cv-card-id">
          <span class="cv-vname">{{name}}</span>
          <span class="cv-vepi">{{epithet}}</span>
        </div>
        <button class="cv-bond-toggle {{#if bonded}}on{{/if}}" data-action="toggleBond" data-virtue="{{key}}">
          {{#if broken}}BROKEN{{else if bonded}}BONDED{{else}}LINK{{/if}}
        </button>
      </div>

      <div class="cv-readout">
        <div class="cv-aff">
          <span class="cv-aff-num {{#if broken}}crit{{/if}}">{{affinity}}</span>
          <span class="cv-aff-lbl">AFFINITY</span>
        </div>
        <div class="cv-rankbox">
          <span class="cv-rank" title="{{rankFlavor}}">BOND {{rank}}</span>
          {{#if reqNext}}<span class="cv-req">NEXT @ {{reqNext}}</span>{{else}}<span class="cv-req">MAX</span>{{/if}}
          {{#if (gt qualified rank)}}<span class="cv-ready">RANK-UP READY</span>{{/if}}
          {{#if broken}}<span class="cv-ready">💔 RESETS AT MISSION CLOSE</span>{{/if}}
        </div>
      </div>

      <div class="cv-bondtext">{{bondText}}</div>

      {{#if bonded}}
      <div class="cv-actions">
        <div class="cv-act-row">
          <span class="cv-act-lbl">CONVERSATION <em>{{convUsed}}/{{../convCap}}</em></span>
          <div class="cv-conv-checks" data-virtue="{{key}}">
            <label class="cv-chk"><input type="checkbox" data-cv="topic"><span>LIKE TOPIC +2</span></label>
            <label class="cv-chk"><input type="checkbox" data-cv="good"><span>WENT WELL +2</span></label>
            <label class="cv-chk"><input type="checkbox" data-cv="conn"><span>CONNECTION +2</span></label>
            <label class="cv-chk bad"><input type="checkbox" data-cv="dislike"><span>DISLIKE −2</span></label>
          </div>
          <button class="cv-mini cv-log" data-action="conv" data-virtue="{{key}}">▸ LOG CONVERSATION</button>
        </div>
        <div class="cv-act-row">
          <span class="cv-act-lbl">CONTRABAND <em>{{contraUsed}}/{{../contraCap}}</em></span>
          <div class="cv-act-btns">
            <button class="cv-mini good" data-action="contra" data-virtue="{{key}}" data-kind="favorite" title="Favorite food (+3)">FAV +3</button>
            <button class="cv-mini good" data-action="contra" data-virtue="{{key}}" data-kind="like" title="A like (+3)">LIKE +3</button>
            <button class="cv-mini" data-action="contra" data-virtue="{{key}}" data-kind="neutral" title="Neutral gift (+1)">NEUTRAL +1</button>
            <button class="cv-mini bad" data-action="contra" data-virtue="{{key}}" data-kind="dislike" title="A dislike (−3)">DISLIKE −3</button>
          </div>
        </div>
        {{#if quirks.length}}
        <details class="cv-intel cv-quirkbox">
          <summary>QUIRKS</summary>
          <div class="cv-act-btns cv-quirklist">
            {{#each quirks}}
            <button class="cv-mini {{#if good}}good{{else}}bad{{/if}}" data-action="quirk"
                    data-virtue="{{../key}}" data-q="{{index}}"
                    title="{{#if perMission}}{{used}}/{{perMission}} this mission{{/if}}">
              {{label}} ({{deltaStr}}){{#if perMission}} [{{used}}/{{perMission}}]{{/if}}
            </button>
            {{/each}}
          </div>
        </details>
        {{/if}}
        {{#if ../isGM}}
        <div class="cv-act-row cv-adjrow">
          <span class="cv-act-lbl">ADMIN ADJUST</span>
          <div class="cv-act-btns">
            <input class="cv-input cv-input-num" name="adj-{{key}}" type="number" value="0" />
            <button class="cv-mini" data-action="adjust" data-virtue="{{key}}">APPLY ±</button>
          </div>
        </div>
        {{/if}}
      </div>
      {{else}}
      <div class="cv-act-row cv-hate">
        <span class="cv-act-lbl">NO LINK</span>
        <button class="cv-mini bad" data-action="contra" data-virtue="{{key}}" data-kind="hatemail" title="Hate-mail to an unbonded virtue (down only, spends 1 stock)">HATE-MAIL</button>
      </div>
      {{/if}}

      <details class="cv-intel">
        <summary>INTEL</summary>
        <p><b>LIKES</b> {{#each likes}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</p>
        <p><b>DISLIKES</b> {{#each dislikes}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</p>
        <p><b>FOOD</b> {{#if food.length}}{{#each food}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}{{else}}—{{/if}}</p>
        <p><b>HIGH BLASPHEMY</b> {{blasphemy}}</p>
      </details>
    </article>
    {{/each}}
  </section>

  {{#if log.length}}
  <details class="cv-intel cv-eventlog">
    <summary>EVENT LOG</summary>
    <ul class="cv-loglist">
      {{#each log}}<li>{{this}}</li>{{/each}}
    </ul>
  </details>
  {{/if}}

  <footer class="cv-foot">
    <button class="cv-btn cv-btn-warn" data-action="endMission">CLOSE MISSION ▸ APPLY RANK-UPS</button>
    {{#if x2mod}}
    <button class="cv-btn" data-action="timeOff" title="X2 mod: rank-ups + limit reset + 1 extra bond slot, without closing the mission">TIME OFF</button>
    {{/if}}
    <button class="cv-btn cv-btn-danger" data-action="reset">WIPE DOSSIER</button>
  </footer>
  </div>

  <div class="cv-statusbar">
    <div class="grow">Ready</div>
    <div>MISSION {{mission}}</div>
    <div>BONDS {{bondsUsed}}/{{bondsAllowed}}</div>
    <div>STOCK {{hqStock}}/6</div>
  </div>
</div>
